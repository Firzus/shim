# --- Self-hosted Convex --------------------------------------------------
# Set when Convex prints these values on first boot (docker compose logs convex).
# `CONVEX_INSTANCE_SECRET` must be supplied BEFORE the first `docker compose up`
# — the Convex container refuses to start without it.
CONVEX_INSTANCE_NAME=shim
CONVEX_INSTANCE_SECRET=
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3220
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Browser-side bundle target. Same host as the URL above by default.
VITE_CONVEX_URL=http://127.0.0.1:3220

# --- Cloudflare Tunnel ---------------------------------------------------
# Token from the Zero Trust dashboard. See ./TUNNEL.md for the full setup.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Ports (override only if there's a collision on your machine) --------
# Defaults match docker-compose.yml. Shim ports are shifted up by 10 from
# cctc to allow both to coexist (cctc: 3111/3210/3211/6791/2000).
APP_PORT=3221
CONVEX_PORT=3220
CONVEX_SITE_PROXY_PORT=3222
CONVEX_DASHBOARD_PORT=6792

# --- Security ------------------------------------------------------------
# IP whitelist for proxy endpoints. "disabled" allows all IPs (dev/local).
# In production behind the Cloudflare tunnel set the Cursor egress IPs.
ALLOWED_IPS=3.209.66.12,52.44.113.131,184.73.225.134