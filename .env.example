# shim configuration — copy to `.env` and fill the blanks below.
# Ports and other fixed values live in docker-compose.yml, not here.

# --- Convex (self-hosted) ------------------------------------------------
# CONVEX_INSTANCE_SECRET must be set BEFORE the first `docker compose up` —
# the Convex container refuses to start without it. The admin key is printed
# in the Convex container logs on first boot; `pnpm convex:deploy` needs it.
CONVEX_INSTANCE_SECRET=
CONVEX_SELF_HOSTED_ADMIN_KEY=
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3220

# --- Cloudflare Tunnel ---------------------------------------------------
# Both required: shim refuses to start without CLOUDFLARE_TUNNEL_URL, and the
# proxy rejects any request that did not transit the tunnel. Token: from the
# Cloudflare Zero Trust dashboard. URL: the tunnel's public origin, e.g.
# https://shim.example.com.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_URL=

# --- Proxy IP allow-list -------------------------------------------------
# Cursor BYOK egress IPs (AWS us-east-1). Refresh if a request is 403'd —
# watch the logs for `[SECURITY] Blocked IP: <ip>`.
ALLOWED_IPS=3.209.66.12,52.44.113.131,184.73.225.134
